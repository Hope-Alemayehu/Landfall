{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,scripts/**,dist/**,final/**,__pycache__/**,api/__pycache__/**,landfall/__pycache__/**,*.png}"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.html" }
  ]
}
